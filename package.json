{
  "name": "webstrip",
  "version": "1.0.1",
  "description": "Easy web stripping via API or CLI.",
  "homepage": "https://github.com/onury/webstrip#readme",
  "author": "Onur Yıldırım <onur@cutepilot.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/onury/webstrip/issues"
  },
  "repository": "onury/webstrip",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "webstrip": "./lib/cli.js"
  },
  "sideEffects": false,
  "files": [
    "lib",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "biome check src test",
    "format": "biome check --write src test",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run lint && npm run typecheck",
    "test": "vitest run",
    "cover": "vitest run --coverage",
    "mutation": "stryker run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "web",
    "strip",
    "scrape",
    "scraper",
    "crawl",
    "http",
    "request",
    "html",
    "puppeteer",
    "headless",
    "chromium",
    "cli",
    "url",
    "page",
    "webstrip"
  ],
  "dependencies": {
    "meow": "^13.2.0",
    "meow-styler": "^1.0.8",
    "puppeteer": "^25.12.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-istanbul": "^4.1.11",
    "biome-config-oy": "^1.1.0",
    "tsconfig-oy": "^2.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
